[Unit]
Description=KieAn website and booking
After=network-online.target

[Service]
Type=simple
User=kiean
Group=kiean
WorkingDirectory=/opt/kiean
ExecStart=/usr/bin/node /opt/kiean/server.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=KIEAN_CONFIG=/etc/kiean/config.json
Environment=KIEAN_DATA_DIR=/var/lib/kiean
EnvironmentFile=/etc/kiean-secrets/kiean.env
Environment=TRUST_PROXY=1
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kiean /etc/kiean

[Install]
WantedBy=multi-user.target
