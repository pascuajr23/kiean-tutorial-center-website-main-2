# Copy to kiean.env on the VPS, fill in, then: chmod 600 kiean.env
# Never commit kiean.env or bake it into the image.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate once with: openssl rand -base64 32  — back it up offline; changing it disconnects every Google account.
KIEAN_TOKEN_ENCRYPTION_KEY=
KIEAN_ADMIN_USER=kieanadmin@gmail.com
# Generate with: openssl rand -base64 24
KIEAN_ADMIN_PASSWORD=
