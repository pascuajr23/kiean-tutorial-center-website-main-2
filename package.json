{
  "name": "kiean-tutorial-booking",
  "version": "0.1.14",
  "description": "Website and teacher booking system for a tutoring center: Google Calendar availability, Meet invitations, Gmail confirmations, GCash QR payments and an admin panel. Zero dependencies.",
  "license": "MIT",
  "author": "Lyndon Pascua Jr",
  "homepage": "https://kieantutorial.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/pascuajr23/kiean-tutorial-center-website-main-2.git"
  },
  "bugs": {
    "url": "https://github.com/pascuajr23/kiean-tutorial-center-website-main-2/issues"
  },
  "keywords": [
    "booking",
    "tutoring",
    "school",
    "google-calendar",
    "google-meet",
    "gcash",
    "nodejs",
    "zero-dependencies"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=kiean.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check-calendar": "node scripts/check-calendar.mjs",
    "reconcile": "node scripts/reconcile.mjs"
  }
}
